# Copy to `.env` at the repo root (already gitignored) and fill in real
# values before running: docker compose -f docker-compose.prod.yml up -d
#
# Generate random secrets with e.g.: openssl rand -hex 32

# --- Server ---
NODE_ENV=production
PORT=5200

# --- Reverse proxy / TLS (Traefik) ---
DOMAIN=medical-connect.example.com
ACME_EMAIL=admin@example.com

# --- CouchDB (self-hosted container, internal network only) ---
COUCHDB_ADMIN_USER=medicalconnect
COUCHDB_ADMIN_PASSWORD=

# --- Auth / sessions ---
SESSION_SECRET=
JWT_SECRET=
JWT_EXPIRATION=7d

# --- Required in production even before LAN/Tauri sync is enabled: the
# server throws on boot without them once NODE_ENV=production. ---
LAN_CERTIFICATE_PRIVATE_KEY=
TENANT_DATA_KEY_ENCRYPTION_SECRET=
# Optional: falls back to SESSION_SECRET if unset.
LAN_TENANT_FINGERPRINT_SECRET=

# --- Patient photo storage (S3-compatible). AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY aren't read directly by this codebase, but the AWS
# SDK's default credential chain picks them up from the environment. ---
AWS_REGION=
AWS_S3_BUCKET_PATIENT_PHOTOS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- One-off admin bootstrap (used by `npm run db:create-platform-admin`,
# run manually after first deploy - not read by the running server). ---
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=
