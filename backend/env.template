# Database Configuration

# Server Configuration
PORT=5001
NODE_ENV=development

# Security
SESSION_SECRET=your-super-secret-key-change-this-in-production
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRATION=7d

# Admin Configuration (optional - for default admin user creation)
ADMIN_PASSWORD=admin123

# LAN device certificate authority. Required in production. Generate an Ed25519
# PKCS#8 private key and store it as PEM (with escaped newlines) or base64 DER.
LAN_CERTIFICATE_PRIVATE_KEY=
LAN_TENANT_FINGERPRINT_SECRET=

# CouchDB (central server only — never required on a shop's desktop machine).
# Matches the credentials in docker-compose.yml for local development.
COUCHDB_URL=http://medicalconnect:medical-connect-dev-password@localhost:5984

# S3 (patient photos). Bucket must be private; the backend is the only
# component that ever holds these credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_PATIENT_PHOTOS=
